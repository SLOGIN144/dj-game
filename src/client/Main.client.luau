--!strict
-- Client entry point. Starts the HUD and the other client controllers.

local Ambience = require(script.Parent.Controllers.Ambience)
local DebugOverlay = require(script.Parent.UI.DebugOverlay)
local Decks = require(script.Parent.Controllers.Decks)
local Dialogue = require(script.Parent.UI.Dialogue)
local Effects = require(script.Parent.Controllers.Effects)
local Fade = require(script.Parent.UI.Fade)
local GoalTracker = require(script.Parent.UI.GoalTracker)
local Guests = require(script.Parent.Controllers.Guests)
local Hud = require(script.Parent.UI.Hud)
local JetGate = require(script.Parent.Controllers.JetGate)
local LightShow = require(script.Parent.Controllers.LightShow)
local OwnPlot = require(script.Parent.Controllers.OwnPlot)
local PadLabels = require(script.Parent.UI.PadLabels)
local PlotMixes = require(script.Parent.Controllers.PlotMixes)
local PlotMusic = require(script.Parent.Controllers.PlotMusic)
local PromptFilter = require(script.Parent.Controllers.PromptFilter)
local Style = require(script.Parent.UI.Style)
local TrackShop = require(script.Parent.UI.TrackShop)

-- The UI accent follows the player's location.
task.spawn(function()
	local plot = OwnPlot.wait()
	local function update()
		local locationId = plot:GetAttribute("LocationId")
		Style.setLocation(if typeof(locationId) == "string" then locationId else nil)
	end
	plot:GetAttributeChangedSignal("LocationId"):Connect(update)
	update()
end)

Hud.start()
Dialogue.start()
PadLabels.start()
PromptFilter.start()
PlotMixes.start()
PlotMusic.start()
LightShow.start()
Guests.start()
Effects.start()
Ambience.start()
JetGate.start()
Fade.start()
TrackShop.start()
Decks.setTracksHandler(TrackShop.open)
Decks.start()
task.spawn(GoalTracker.start)
DebugOverlay.start()
