--!strict
-- Server entry point: builds the street, then starts the services and hands out plots.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Crates = require(script.Parent.Services.Crates)
local Decks = require(script.Parent.Services.Decks)
local Delivery = require(script.Parent.Services.Delivery)
local DevTools = require(script.Parent.Services.DevTools)
local Economy = require(script.Parent.Services.Economy)
local Events = require(script.Parent.Services.Events)
local Goals = require(script.Parent.Services.Goals)
local Leaderboard = require(script.Parent.Services.Leaderboard)
local Music = require(script.Parent.Services.Music)
local Plots = require(script.Parent.Services.Plots)
local Progression = require(script.Parent.Services.Progression)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Settings = require(script.Parent.Services.Settings)
local Shop = require(script.Parent.Services.Shop)
local StarDjs = require(script.Parent.Services.StarDjs)
local TrackShop = require(script.Parent.Services.TrackShop)
local Travel = require(script.Parent.Services.Travel)
local Wishes = require(script.Parent.Services.Wishes)
local StreetProps = require(script.Parent.World.StreetProps)

Remotes.createAll() -- before anything: clients wait for every remote when they start
local plots = Plots.build()
Economy.start(plots)
Shop.start()
Delivery.start()
Music.start()
Decks.start()
TrackShop.start()
Events.start()
Goals.start()
Wishes.start()
Travel.start()
Progression.start()
StarDjs.start()
Crates.start()
Settings.start()
DevTools.start()
Leaderboard.start(StreetProps.screen(workspace:WaitForChild("Street")))
Plots.start(function(state)
	Shop.refresh(state)
	Music.begin(state)
	Events.begin(state)
	Goals.begin(state)
	Wishes.begin(state)
	StarDjs.begin(state)
end, function(state)
	Delivery.stop(state)
	Wishes.stop(state)
	Events.stop(state)
	Music.stop(state.plot)
end)
